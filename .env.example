# Copy this file to .env and enter your AI provider key.
# The application can start without a key, but AI features will not work.
SPRING_AI_OPENAI_API_KEY=

# Optional overrides
DRILLIX_PORT=8080
SPRING_AI_OPENAI_BASE_URL=https://openai.bothub.chat/v1
SPRING_AI_OPENAI_CHAT_OPTIONS_MODEL=deepseek-v4.1-flash-1017
